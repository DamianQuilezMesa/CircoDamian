<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
            prefWidth="1180" prefHeight="800"
            stylesheets="@../styles/Styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.damianqm.tarea3adt.controller.GestionEspectaculoController">

  <top>
    <VBox styleClass="background" spacing="4">
      <padding><Insets top="14" left="24" bottom="12" right="24"/></padding>
      <Label text="Gestión de Espectáculos" textFill="WHITE"><font><Font size="18"/></font></Label>
      <Label text="Paso 1: crea o edita el espectáculo. Paso 2: gestiona sus números directamente."
             textFill="#aaaaaa" style="-fx-font-size:12;" wrapText="true"/>
    </VBox>
  </top>

  <center>
    <SplitPane dividerPositions="0.27">

      <!-- ==== IZQUIERDA: selector ==== -->
      <VBox spacing="10" style="-fx-padding:14; -fx-background-color:#f5f5f5;" minWidth="280">
        <Label text="Espectáculos existentes:" style="-fx-font-weight:bold;"/>
        <ComboBox fx:id="cbEspectaculo" maxWidth="Infinity" prefHeight="34"
                  promptText="-- Selecciona para modificar --"/>
        <Button text="+ Nuevo espectáculo" onAction="#nuevoEspectaculo"
                maxWidth="Infinity" prefHeight="34"
                style="-fx-font-weight:bold;"/>
        <Separator/>
        <Label fx:id="lblMensaje" text="" wrapText="true" maxWidth="Infinity"
               style="-fx-font-size:12; -fx-padding:8 0 0 0;"/>
      </VBox>

      <!-- ==== DERECHA: wizard de 2 pasos ==== -->
      <VBox spacing="0">

        <!-- ========== PASO 1: datos del espectáculo ========== -->
        <VBox fx:id="panelPaso1" spacing="12" style="-fx-padding:20;">
          <Label text="PASO 1 — Datos del espectáculo"
                 style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#1a1a2e;"/>
          <Separator/>

          <GridPane hgap="18" vgap="10" maxWidth="Infinity">
            <columnConstraints>
              <ColumnConstraints percentWidth="50"/>
              <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <Label text="Nombre (máx. 25 caracteres):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Coordinador:"                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombreEsp" promptText="Nombre del espectáculo"
                       prefHeight="34" maxWidth="Infinity"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbCoordinador" prefHeight="34" maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Fecha inicio:"             GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text="Fecha fin (máx. 1 año):"  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <DatePicker fx:id="dpInicio" prefHeight="34" maxWidth="Infinity"
                        GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <DatePicker fx:id="dpFin"    prefHeight="34" maxWidth="Infinity"
                        GridPane.columnIndex="1" GridPane.rowIndex="3"/>
          </GridPane>

          <Separator/>
          <HBox spacing="14" alignment="CENTER_LEFT">
            <Button text="Siguiente: añadir números →" onAction="#siguiente"
                    prefWidth="240" prefHeight="38" styleClass="btnGreen"
                    style="-fx-font-size:13; -fx-font-weight:bold;"/>
            <Label text="Nada se guarda todavía. El espectáculo se persiste al pulsar «Guardar espectáculo» en el paso siguiente."
                   style="-fx-font-size:11; -fx-text-fill:#888;" wrapText="true" maxWidth="400"/>
          </HBox>
        </VBox>

        <!-- ========== PASO 2: gestión de números del espectáculo ========== -->
        <VBox fx:id="panelPaso2" spacing="10" style="-fx-padding:20;"
              visible="false" managed="false">

          <Label fx:id="lblEspActual" text=""
                 style="-fx-font-size:14; -fx-font-weight:bold; -fx-text-fill:#1a1a2e;"/>
          <Label fx:id="lblContador" text=""
                 style="-fx-font-weight:bold; -fx-text-fill:#e67e22; -fx-font-size:12;"/>
          <Separator/>

          <!-- ===== Subformulario de número ===== -->
          <VBox spacing="8" style="-fx-background-color:#eef4fb; -fx-background-radius:6; -fx-padding:14; -fx-border-color:#c9dff3; -fx-border-radius:6;">
            <Label text="Datos del número" style="-fx-font-weight:bold; -fx-font-size:13; -fx-text-fill:#1a1a2e;"/>

            <GridPane hgap="14" vgap="6">
              <columnConstraints>
                <ColumnConstraints percentWidth="45"/>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="15"/>
              </columnConstraints>

              <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
              <Label text="Duración (x,0 / x,5):" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
              <Label text="Orden:"  GridPane.columnIndex="2" GridPane.rowIndex="0"/>

              <TextField fx:id="txtNombreNum" promptText="Nombre del número"
                         prefHeight="34" maxWidth="Infinity"
                         GridPane.columnIndex="0" GridPane.rowIndex="1"/>
              <TextField fx:id="txtDuracion" promptText="ej: 8,5"
                         prefHeight="34" maxWidth="Infinity"
                         GridPane.columnIndex="1" GridPane.rowIndex="1"/>
              <TextField fx:id="txtOrden" promptText="1"
                         prefHeight="34" maxWidth="Infinity"
                         GridPane.columnIndex="2" GridPane.rowIndex="1"/>
              <Button fx:id="btnGuardarNumero" text="Añadir número" onAction="#guardarNumero"
                      prefHeight="34" maxWidth="Infinity" styleClass="btnGreen"
                      style="-fx-font-weight:bold;"
                      GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            </GridPane>

            <Label text="Artistas participantes (selección múltiple):"
                   style="-fx-font-size:11; -fx-text-fill:#555;"/>
            <ListView fx:id="listArtistas" prefHeight="110"/>

            <HBox spacing="8">
              <Button text="Limpiar formulario" onAction="#nuevoNumero"
                      prefHeight="30" style="-fx-font-size:11;"/>
            </HBox>
          </VBox>

          <!-- ===== Tabla de números ya en el espectáculo ===== -->
          <Label text="Números del espectáculo (mínimo 3):" style="-fx-font-weight:bold;"/>
          <TableView fx:id="tablaNumeros" VBox.vgrow="ALWAYS" prefHeight="220">
            <columns>
              <TableColumn fx:id="colOrden"    text="#"        prefWidth="50"  minWidth="40"/>
              <TableColumn fx:id="colNombre"   text="Número"   prefWidth="200" minWidth="140"/>
              <TableColumn fx:id="colDuracion" text="Duración" prefWidth="100" minWidth="80"/>
              <TableColumn fx:id="colArtistas" text="Artistas" prefWidth="350" minWidth="200"/>
            </columns>
            <columnResizePolicy>
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
          </TableView>

          <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="✎ Editar seleccionado" onAction="#editarNumero"
                    prefHeight="32" prefWidth="180"
                    style="-fx-background-color:#2980b9;-fx-text-fill:white;-fx-font-weight:bold;"/>
            <Button text="✕ Eliminar seleccionado" onAction="#eliminarNumero"
                    prefHeight="32" prefWidth="190"
                    style="-fx-background-color:#e74c3c;-fx-text-fill:white;-fx-font-weight:bold;"/>
          </HBox>

          <Separator/>
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="← Volver al Paso 1" onAction="#volverPaso1"
                    prefHeight="36" prefWidth="160"/>
            <Button text="💾 Guardar espectáculo" onAction="#guardarEspectaculo"
                    prefHeight="36" prefWidth="220" styleClass="btnGreen"
                    style="-fx-font-size:13; -fx-font-weight:bold;"/>
            <Label text="Valida todo el conjunto (mínimo 3 números) y guarda en una sola operación."
                   style="-fx-font-size:11; -fx-text-fill:#888;" wrapText="true" maxWidth="300"/>
          </HBox>
        </VBox>

      </VBox>
    </SplitPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="12">
      <padding><Insets bottom="14" right="24" top="12" left="24"/></padding>
      <Button text="Volver al menú" onAction="#volver"
              prefWidth="140" prefHeight="36"/>
    </HBox>
  </bottom>
</BorderPane>
