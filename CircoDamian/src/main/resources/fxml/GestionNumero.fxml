<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
            prefWidth="1100" prefHeight="750"
            stylesheets="@../styles/Styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.damianqm.tarea3adt.controller.GestionNumeroController">

  <top>
    <VBox styleClass="background" spacing="4">
      <padding><Insets top="14" left="24" bottom="12" right="24"/></padding>
      <Label text="Editar Números Circenses" textFill="WHITE"><font><Font size="18"/></font></Label>
      <Label text="Selecciona un espectáculo y luego el número a modificar."
             textFill="#aaaaaa" style="-fx-font-size:12;" wrapText="true"/>
    </VBox>
  </top>

  <center>
    <SplitPane dividerPositions="0.30">

      <!-- ==== IZQUIERDA: selección ==== -->
      <VBox spacing="10" style="-fx-padding:14; -fx-background-color:#f5f5f5;" minWidth="280">
        <Label text="Espectáculo:" style="-fx-font-weight:bold;"/>
        <ComboBox fx:id="cbEspectaculo" maxWidth="Infinity" prefHeight="34"/>
        <Separator/>
        <Label text="Número:" style="-fx-font-weight:bold;"/>
        <ComboBox fx:id="cbNumero" maxWidth="Infinity" prefHeight="34"/>
        <Separator/>
        <Button text="Limpiar selección" onAction="#limpiar"
                maxWidth="Infinity" prefHeight="32"/>
        <Label fx:id="lblMensaje" text="" wrapText="true" maxWidth="Infinity"
               style="-fx-font-size:12; -fx-padding:8 0 0 0;"/>
      </VBox>

      <!-- ==== DERECHA: formulario de edición ==== -->
      <VBox spacing="12" style="-fx-padding:20;">
        <Label fx:id="lblTitulo" text="Selecciona un espectáculo y un número"
               style="-fx-font-size:15; -fx-font-weight:bold; -fx-text-fill:#1a1a2e;"/>
        <Separator/>

        <GridPane hgap="18" vgap="10" maxWidth="Infinity">
          <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
          </columnConstraints>

          <Label text="Nombre del número:"        GridPane.columnIndex="0" GridPane.rowIndex="0"/>
          <Label text="Duración (x,0 / x,5 min):" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
          <Label text="Orden en el espectáculo:"  GridPane.columnIndex="2" GridPane.rowIndex="0"/>

          <TextField fx:id="txtNombre"   promptText="Nombre"       prefHeight="34" maxWidth="Infinity"
                     GridPane.columnIndex="0" GridPane.rowIndex="1"/>
          <TextField fx:id="txtDuracion" promptText="ej: 8,5"     prefHeight="34" maxWidth="Infinity"
                     GridPane.columnIndex="1" GridPane.rowIndex="1"/>
          <TextField fx:id="txtOrden"    promptText="ej: 2"        prefHeight="34" maxWidth="Infinity"
                     GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        </GridPane>

        <Separator/>
        <Label text="Artistas participantes (selección múltiple):"
               style="-fx-font-weight:bold;"/>
        <ListView fx:id="listArtistas" prefHeight="140" VBox.vgrow="NEVER"/>

        <Separator/>
        <Label text="Artistas actualmente asignados:" style="-fx-font-weight:bold;"/>
        <TableView fx:id="tablaArtistasAsignados" prefHeight="140" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colNombreArtista" text="Artista"      prefWidth="200"/>
            <TableColumn fx:id="colEspecArtista"  text="Especialidades" prefWidth="300"/>
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        </TableView>

        <Separator/>
        <HBox spacing="12" alignment="CENTER_LEFT">
          <Button fx:id="btnGuardar" text="Guardar cambios" onAction="#guardar"
                  prefHeight="36" prefWidth="180" styleClass="btnGreen"
                  style="-fx-font-size:13; -fx-font-weight:bold;"/>
          <Button fx:id="btnEliminar" text="Eliminar número" onAction="#eliminar"
                  prefHeight="36" prefWidth="180"
                  style="-fx-font-size:13; -fx-font-weight:bold; -fx-background-color:#c0392b; -fx-text-fill:white;"/>
        </HBox>
      </VBox>

    </SplitPane>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="12">
      <padding><Insets bottom="14" right="24" top="12" left="24"/></padding>
      <Button text="Volver al menú" onAction="#volver"
              prefWidth="140" prefHeight="36"/>
    </HBox>
  </bottom>
</BorderPane>
