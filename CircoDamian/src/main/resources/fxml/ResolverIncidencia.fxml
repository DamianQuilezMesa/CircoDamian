<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="1120" prefHeight="760"
            stylesheets="@../styles/Styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.damianqm.tarea3adt.controller.ResolverIncidenciaController">
  <top>
    <VBox styleClass="background" spacing="4">
      <padding><Insets top="14" left="24" bottom="12" right="24"/></padding>
      <Label text="Resolver Incidencia" textFill="WHITE"><font><Font size="18"/></font></Label>
      <Label text="Selecciona una incidencia pendiente y documenta su resolución."
             textFill="#aaaaaa" style="-fx-font-size:12;"/>
    </VBox>
  </top>

  <center>
    <VBox spacing="12" style="-fx-padding:20;">

      <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Refrescar" onAction="#refrescar" prefHeight="32" prefWidth="100"/>
        <Label fx:id="lblSeleccionada" text="" style="-fx-text-fill:#555; -fx-font-size:12;"/>
      </HBox>

      <!-- Tabla de incidencias (verde=resuelta, naranja=pendiente) -->
      <TableView fx:id="tablaIncidencias" VBox.vgrow="ALWAYS" prefHeight="350">
        <columns>
          <TableColumn fx:id="colId"     text="ID"     prefWidth="60"/>
          <TableColumn fx:id="colFecha"  text="Fecha"  prefWidth="130"/>
          <TableColumn fx:id="colTipo"   text="Tipo"   prefWidth="110"/>
          <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
          <TableColumn fx:id="colDesc"   text="Descripción" prefWidth="580"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder><Label text="No hay incidencias registradas."/></placeholder>
      </TableView>

      <Separator/>

      <Label text="Acciones realizadas para resolver la incidencia *:"
             style="-fx-font-weight:bold;"/>
      <TextArea fx:id="taAcciones" prefHeight="100" wrapText="true"
                promptText="Describe qué se hizo para resolver la incidencia..."/>

      <Label fx:id="lblMensaje" text="" wrapText="true"/>

      <HBox spacing="12">
        <Button text="Marcar como resuelta" onAction="#resolver"
                prefWidth="200" prefHeight="36"
                style="-fx-background-color:#e67e22; -fx-text-fill:white; -fx-font-weight:bold;"/>
      </HBox>
    </VBox>
  </center>

  <bottom>
    <HBox alignment="CENTER_RIGHT">
      <padding><Insets bottom="14" right="24" top="12" left="24"/></padding>
      <Button text="Volver al menú" onAction="#volver" prefWidth="140" prefHeight="36"/>
    </HBox>
  </bottom>
</BorderPane>
